rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "jbonilla2987@gmail.com"; }
    function isApproved(userId) { return isAdmin() || (signedIn() && request.auth.uid == userId && exists(/databases/$(database)/documents/accessRequests/$(userId)) && get(/databases/$(database)/documents/accessRequests/$(userId)).data.status == "approved"); }
    function userIsApproved(userId) { return signedIn() && exists(/databases/$(database)/documents/accessRequests/$(userId)) && get(/databases/$(database)/documents/accessRequests/$(userId)).data.status == "approved"; }
    function isChatParticipant(chatId) { return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId)) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
    match /accessRequests/{userId} {
      allow list: if isAdmin(); allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.status == "pending" && request.resource.data.role == "user" && request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin(); allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId && resource.data.status == "approved");
    }
    match /liveLocations/{userId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId && isApproved(userId) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.lat is number && request.resource.data.lng is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId && isApproved(userId));
    }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId && isApproved(userId));
      allow create, update, delete: if signedIn() && request.auth.uid == userId && isApproved(userId);
      match /{document=**} { allow read: if isAdmin() || (signedIn() && request.auth.uid == userId && isApproved(userId)); allow create, update, delete: if signedIn() && request.auth.uid == userId && isApproved(userId); }
    }
    match /publicProfiles/{userId} {
      allow read: if signedIn() && userIsApproved(request.auth.uid);
      allow create, update: if signedIn() && request.auth.uid == userId && userIsApproved(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && userIsApproved(request.auth.uid) && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants && userIsApproved(request.resource.data.participants[0]) && userIsApproved(request.resource.data.participants[1]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants && request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update: if false; allow delete: if isAdmin();
      }
    }
  }
}
