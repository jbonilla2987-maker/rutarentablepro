{
  "name": "rutarentable-pro-ios",
  "version": "4.1.9",
  "private": true,
  "description": "RutaRentable PRO 4.1.9 - administradores configurables",
  "scripts": {
    "ios:add": "npx cap add ios --packagemanager SPM",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
